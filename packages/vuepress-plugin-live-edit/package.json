{
  "name": "@needle-tools/vuepress-plugin-live-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dev-only in-page WYSIWYG editing for the Needle docs: edit a page where you read it, paste screenshots straight into the markdown, and write back minimal diffs.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client/index.mjs",
    "./core": "./src/core/index.mjs"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --test \"test/**/*.test.mjs\"",
    "test:browser": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@mdit-vue/shared": "^2.1.3",
    "@vue/compiler-dom": "^3.5.18",
    "@vue/compiler-sfc": "^3.5.18",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "playwright": "^1.63.0",
    "vitest": "^5.0.1"
  }
}
